# ==============================================================================
# SmartCanteen AI - Environment Configuration Example
# Copy this file to .env.local for local development.
# In production (e.g. Vercel), add these variables in your deployment settings.
# ==============================================================================

# Database Connection (Required)
# In development: mongodb://127.0.0.1:27017/smartcanteen (or use embedded DB via pnpm run db)
# In production: Your MongoDB Atlas cloud connection string:
# mongodb+srv://<username>:<password>@<cluster-address>.mongodb.net/smartcanteen?retryWrites=true&w=majority
MONGODB_URI=

# NextAuth Authentication & Session Security (Required)
# Generate a secure 32+ character random string in terminal: openssl rand -base64 32
NEXTAUTH_SECRET=

# Canonical Application URLs (Required)
# In development: http://localhost:3000
# In production: https://your-canteen-domain.vercel.app
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Default Restaurant / Canteen Identifier (Optional)
# Matches the username of your primary canteen account (defaults to "starbucks")
NEXT_PUBLIC_DEFAULT_RESTAURANT=starbucks

# AI Menu Assistant (Jarvis) - Optional
# Set any one of the following keys to enable Google Gemini generative AI.
# If omitted, Jarvis runs smoothly using the built-in Smart Canteen Local Recommendation Engine.
GEMINI_API_KEY=
# Alternative provider keys (optional fallbacks):
# GROQ_API_KEY=
# OPENAI_API_KEY=

# Production Safeguards (Optional)
# Set to "true" only in development to allow GET /api/refreshDemoData to reset demo accounts.
# Disabled by default in production.
ENABLE_DEMO_SEEDING=false
